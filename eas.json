{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_BASE_URL": "https://rangasscheme.brightechsoftware.com/api/v1",
        "IMAGE_BASE_URL": "https://scheme.dhanapaljewellery.com"
      }
    }
  }
}
