{
  "expo": {
    "name": "Rangas DigiGold",
    "slug": "agritrack",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brightechsoftware.rangasthangamaligai",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.brightechsoftware.rangasthangamaligai",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
  "@react-native-firebase/app",
  "@react-native-firebase/messaging",

  [
    "@react-native-google-signin/google-signin",
    {
      "iosUrlScheme": "com.googleusercontent.apps.401290584973-uvp04rtruok5kkhq3ip5aon76j9r491t"
    }
  ],

  [
    "expo-local-authentication",
    {
      "faceIDPermission": "Allow Rangas DigiGold to use Face ID to unlock the app."
    }
  ],

  [
    "expo-build-properties",
    {
      "android": {
        "extraProguardRules": "",
        "blocklistedPermissions": [
          "android.permission.READ_MEDIA_IMAGES",
          "android.permission.READ_MEDIA_VIDEO",
          "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
          "android.permission.READ_EXTERNAL_STORAGE",
          "android.permission.WRITE_EXTERNAL_STORAGE",
          "android.permission.READ_MEDIA_AUDIO"
        ]
      }
    }
  ],

  "./plugins/withRemoveMediaPermissions.js"
],
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "cad0862e-b0c0-48c0-bf27-7cde04e6d11f"
      }
    },
    "owner": "jk_08"
  }
}
