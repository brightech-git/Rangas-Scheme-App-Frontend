{
  "expo": {
    "name": "Rangas DigiGold",
    "slug": "rangas-scheme",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brightechsoftware.rangasthangamaligai",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.brightechsoftware.rangasthangamaligai",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      ["@react-native-google-signin/google-signin", {
        "iosUrlScheme": "com.googleusercontent.apps.401290584973-uvp04rtruok5kkhq3ip5aon76j9r491t"
      }],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Rangas DigiGold to use Face ID to unlock the app."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "",
            "blocklistedPermissions": [
              "android.permission.READ_MEDIA_IMAGES",
              "android.permission.READ_MEDIA_VIDEO",
              "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
              "android.permission.READ_EXTERNAL_STORAGE",
              "android.permission.WRITE_EXTERNAL_STORAGE",
              "android.permission.READ_MEDIA_AUDIO"
            ]
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "08083d0b-79af-49cb-85bc-268b86581f16"
      }
    },
    "owner": "kiruba08"
  }
}
